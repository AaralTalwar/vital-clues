{
  "id": "cold-uv",
  "name": "Cold & sunlight on snow",
  "colour": "blue",
  "inputs": {
    "primary": {
      "key": "O",
      "label": "Hours outside",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "h",
      "ticks": [
        "none",
        "3 h",
        "6 h"
      ]
    },
    "secondary": {
      "key": "C",
      "label": "How cold",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 7,
      "ticks": [
        "mild",
        "chilly",
        "freezing"
      ]
    }
  },
  "constants": {
    "uv": 4,
    "snow": 1.8
  },
  "outputs": [
    {
      "key": "E",
      "label": "UV energy reaching the face",
      "unit": "units",
      "colour": "amber",
      "decimals": 0
    },
    {
      "key": "B",
      "label": "Face redness that night",
      "unit": "0–10",
      "colour": "coral",
      "decimals": 1
    },
    {
      "key": "V",
      "label": "Shivering now",
      "unit": "0–10",
      "colour": "blue",
      "decimals": 0
    },
    {
      "key": "F",
      "label": "Blood flow to skin",
      "colour": "purple",
      "bands": [
        {
          "upTo": 55,
          "text": "low"
        },
        {
          "upTo": 80,
          "text": "reduced"
        },
        {
          "text": "normal"
        }
      ]
    }
  ],
  "rules": {
    "E": "uv * snow * O",
    "B": "clamp((uv * snow * O - 12) / 2, 0, 10)",
    "V": "round(clamp(0.9 * C - 1, 0, 10))",
    "F": "100 - 6 * C"
  },
  "chart": {
    "x": "O",
    "y": "B",
    "xLabel": "hours outside",
    "yLabel": "face redness that night (0–10)",
    "yMin": 0,
    "yMax": 10
  },
  "overlay": {
    "base": "torso",
    "caption": "cold: fast response, gone when warm · UV: silent damage, red hours later",
    "parts": [
      {
        "shape": "snow",
        "colour": "#8FA3C7"
      },
      {
        "shape": "sun",
        "colour": "#F4A300"
      },
      {
        "shape": "skin",
        "colour": "#E4572E",
        "anim": {
          "type": "shift",
          "output": "B",
          "min": 0,
          "max": 10,
          "from": "#F7F9FD",
          "to": "#E4572E"
        }
      },
      {
        "shape": "shiverMarks",
        "colour": "#2E86DE",
        "anim": {
          "type": "shiver",
          "output": "V"
        }
      }
    ]
  },
  "limits": {
    "does": [
      "Shows UV energy adding up with hours outside, boosted by light bouncing off snow",
      "Shows redness appearing only after a threshold dose, hours later",
      "Shows shivering depending on the cold, not on the sunlight"
    ],
    "doesnt": [
      "Measure any real person — the numbers are illustrative teaching values",
      "Account for skin tone, altitude, clouds or time of day",
      "Show any dangerous cold"
    ],
    "text": "This is a simplified learning model. Real people vary with age, fitness and health. The numbers are illustrative, not measurements of any real person.",
    "wellbeing": "Snow reflects sunlight: on bright days a hat and sunscreen help. Tell an adult about blistering or feeling sick."
  },
  "sources": [
    "CK-12 Life Science: integumentary system",
    "US EPA SunWise: UV Index for students"
  ]
}
