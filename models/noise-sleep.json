{
  "id": "noise-sleep",
  "name": "Loud sound & short sleep",
  "colour": "purple",
  "inputs": {
    "primary": {
      "key": "V",
      "label": "Loudness",
      "min": 70,
      "max": 110,
      "step": 5,
      "unit": "dB",
      "ticks": [
        "70 · busy café",
        "90 · traffic",
        "110 · concert"
      ]
    },
    "secondary": {
      "key": "S",
      "label": "Hours of sleep",
      "min": 3,
      "max": 9,
      "step": 0.5,
      "default": 5,
      "unit": "h",
      "ticks": [
        "3 h",
        "6 h",
        "9 h"
      ]
    }
  },
  "constants": {
    "T": 180
  },
  "outputs": [
    {
      "key": "L",
      "label": "Sound energy",
      "unit": "× talking level",
      "colour": "amber",
      "decimals": 0
    },
    {
      "key": "F",
      "label": "Hair-cell fatigue",
      "unit": "0–10",
      "colour": "purple",
      "decimals": 1
    },
    {
      "key": "R",
      "label": "Ringing next morning",
      "colour": "coral",
      "bands": [
        {
          "upTo": 2.9,
          "text": "none"
        },
        {
          "upTo": 6.9,
          "text": "a little"
        },
        {
          "text": "yes"
        }
      ]
    },
    {
      "key": "A",
      "label": "Morning focus",
      "unit": "0–10",
      "colour": "teal",
      "decimals": 1
    }
  ],
  "rules": {
    "L": "round(pow(10, (V - 60) / 10))",
    "F": "clamp(pow(10, (V - 95) / 10) * T / 60, 0, 10)",
    "R": "clamp(pow(10, (V - 95) / 10) * T / 60, 0, 10)",
    "A": "clamp(10 - 1.4 * (8 - S), 1, 10)"
  },
  "chart": {
    "x": "V",
    "y": "F",
    "xLabel": "loudness (dB)",
    "yLabel": "hair-cell fatigue (0–10)",
    "yMin": 0,
    "yMax": 10
  },
  "overlay": {
    "base": "head",
    "caption": "loud sound tires hair cells · short sleep tires the brain",
    "parts": [
      {
        "shape": "soundWaves",
        "colour": "#F4A300",
        "anim": {
          "type": "count",
          "output": "L",
          "min": 0,
          "max": 10000
        }
      },
      {
        "shape": "ear",
        "colour": "#6C4AB6"
      },
      {
        "shape": "hairCells",
        "colour": "#E4572E",
        "anim": {
          "type": "bend",
          "output": "F",
          "min": 0,
          "max": 10
        }
      },
      {
        "shape": "moon",
        "colour": "#F4A300",
        "anim": {
          "type": "glow",
          "output": "A",
          "min": 1,
          "max": 10
        }
      }
    ]
  },
  "limits": {
    "does": [
      "Shows hair-cell fatigue rising steeply with loudness over a three-hour concert",
      "Shows morning focus falling with each hour of sleep lost",
      "Shows the two as separate effects: earplugs don't fix sleep, and sleep doesn't fix ringing"
    ],
    "doesnt": [
      "Measure any real person — the numbers are illustrative teaching values",
      "Model permanent hearing damage; it stops at temporary ringing",
      "Include caffeine, naps or how interesting the class is"
    ],
    "text": "This is a simplified learning model. Real people vary with age, fitness and health. The numbers are illustrative, not measurements of any real person.",
    "wellbeing": "Ringing that lasts more than a day, or feeling exhausted every day, is worth telling an adult about."
  },
  "sources": [
    "NIH NIDCD: Noise-Induced Hearing Loss (student pages)",
    "CK-12 Life Science: nervous system and sleep"
  ]
}
